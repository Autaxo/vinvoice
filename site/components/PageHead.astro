---
interface Props {
  title: string;
  lead?: string;
  crumbs?: { href: string; label: string }[];
}
const { title, lead, crumbs } = Astro.props;
---

<div class="page-head">
  {
    crumbs && (
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c) => (
            <li>
              <a href={c.href}>{c.label}</a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }
  <h1><slot name="title">{title}</slot></h1>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>
