---
// BG-32 rows of the first invoice line of a corpus file, as a two-column table.
import { rows, lineObjectId, type CorpusFile } from '../lib/corpus';

interface Props {
  file: CorpusFile;
  caption?: string;
}
const { file, caption } = Astro.props;
const list = rows(file);
const bt128 = lineObjectId(file);
---

<div class="table-wrap">
  <table>
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        <th scope="col">Name (BT-160)</th>
        <th scope="col">Value (BT-161)</th>
      </tr>
    </thead>
    <tbody>
      {
        list.map((r) => (
          <tr>
            <td>
              {r.href ? (
                <a href={r.href}>
                  <code>{r.name}</code>
                </a>
              ) : (
                <code>{r.name}</code>
              )}
            </td>
            <td>
              <code>{r.value}</code>
            </td>
          </tr>
        ))
      }
      {
        bt128 && (
          <tr>
            <td>
              <span class="muted">Line object identifier (BT-128), scheme </span>
              <code>{bt128.scheme}</code>
            </td>
            <td>
              <code>{bt128.id}</code>
            </td>
          </tr>
        )
      }
    </tbody>
  </table>
</div>
