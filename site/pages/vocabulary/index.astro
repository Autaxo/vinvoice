---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import {
  registry,
  terms,
  tiers,
  tierLabel,
  termsByTier,
  termUrl,
  unitInfo,
  valueSummary,
  REF,
} from '../../lib/registry';
import { SITE } from '../../lib/site';
import Key from '../../components/Key.astro';

const setUrl = `${SITE.url}/vocabulary/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': setUrl,
  name: 'VINvoice vocabulary',
  description: 'Keys for vehicle data in EN 16931 item attributes (BG-32).',
  version: registry.version,
  dateModified: registry.date,
  license: 'https://creativecommons.org/publicdomain/zero/1.0/',
  hasDefinedTerm: terms.map((t) => ({
    '@type': 'DefinedTerm',
    '@id': SITE.url + termUrl(t),
    termCode: t.key,
    name: t.labelEn,
  })),
};

const tierText: Record<string, string> = {
  core: 'Needed to identify and describe a vehicle on sales, trade-in and workshop invoices, plus the statutory features of VAT law.',
  recommended: 'Widely available facts that receivers commonly ask for.',
  optional: 'Provisional for 12 months after first publication; some wait for a legal review.',
};
---

<Base
  title="Vocabulary"
  description={`All ${terms.length} VINvoice keys by tier, with labels, value formats and units.`}
  jsonLd={jsonLd}
>
  <PageHead
    title="Vocabulary"
    lead={`${terms.length} keys in ${tiers.length} tiers. Each key has its own page with the definition, value format, conditions and legal anchors.`}
  />

  <div class="prose">
    <p>
      A row name is the registry label followed by the key in brackets, for example
      <code>{REF.make.labelDe} [{REF.make.key}]</code>. Keys marked <span class="tag statutory"
        >statutory</span
      > carry a feature that VAT law requires on the invoice; they must always be written with their label.
      The marker <Key t={REF.marker} /> is listed first because every vehicle line starts with it.
    </p>
  </div>

  <div class="filter" id="filter" hidden>
    <label for="q">Filter keys</label>
    <input
      id="q"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="key, label or unit"
    />
    <output for="q" id="q-count" aria-live="polite"></output>
  </div>

  {
    tiers.map((tier) => (
      <section aria-labelledby={`tier-${tier}`} data-tier>
        <h2 id={`tier-${tier}`}>
          {tierLabel(tier)} <span class="muted">({termsByTier(tier).length})</span>
        </h2>
        {tierText[tier] && <p class="prose">{tierText[tier]}</p>}
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Key</th>
                <th scope="col">Label (EN)</th>
                <th scope="col">Label (DE)</th>
                <th scope="col">Value</th>
                <th scope="col">Unit</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody>
              {termsByTier(tier).map((t) => {
                const unit = unitInfo(t);
                return (
                  <tr
                    data-search={[t.key, t.labelEn, t.labelDe, unit?.name ?? '', unit?.code ?? '']
                      .join(' ')
                      .toLowerCase()}
                  >
                    <td>
                      <a href={termUrl(t)}>
                        <code>{t.key}</code>
                      </a>
                    </td>
                    <td>{t.labelEn}</td>
                    <td lang="de">{t.labelDe}</td>
                    <td class="small">{valueSummary(t)}</td>
                    <td class="small">{unit ? unit.name : ''}</td>
                    <td>
                      {t.statutory && <span class="tag statutory">statutory</span>}{' '}
                      {t.status !== 'draft' && <span class="tag provisional">{t.status}</span>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }

  <p class="small muted prose">
    Also available as <a href="/downloads/registry.json">registry.json</a>, <a
      href="/downloads/registry.csv">registry.csv</a
    >, <a href="/downloads/context.jsonld">context.jsonld</a> and as a JSON Schema, <a
      href="/downloads/vehicle-facts.schema.json">vehicle-facts.schema.json</a
    > (CC0 1.0).
  </p>

  <script is:inline src="/vocabulary-filter.js" defer></script>
</Base>
