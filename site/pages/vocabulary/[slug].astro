---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import {
  terms,
  slug,
  termUrl,
  tierLabel,
  rowName,
  unitInfo,
  tokenListsFor,
  countryScope,
  linkKeys,
  splitList,
  crosswalkFor,
  crosswalkHeader,
  registry,
  type Term,
} from '../../lib/registry';
import { corpusValues } from '../../lib/corpus';
import { SITE } from '../../lib/site';

export function getStaticPaths() {
  return terms.map((t, i) => ({
    params: { slug: slug(t) },
    props: { t, prev: terms[i - 1], next: terms[i + 1] },
  }));
}

interface Props {
  t: Term;
  prev?: Term;
  next?: Term;
}
const { t, prev, next } = Astro.props;
const unit = unitInfo(t);
const lists = tokenListsFor(t);
const scope = countryScope(t);
const anchors = splitList(t.anchors);
const examples = corpusValues(t.key).slice(0, 5);
const crosswalk = crosswalkFor(t);
const crosswalkNote = crosswalkHeader[1]?.match(/\(([^)]*)\)/)?.[1];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  '@id': SITE.url + termUrl(t),
  identifier: registry.iriBase + t.key.slice(registry.root.length + 1),
  termCode: t.key,
  name: t.labelEn,
  alternateName: { '@language': 'de', '@value': t.labelDe },
  description: t.definition,
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    '@id': `${SITE.url}/vocabulary/`,
    version: registry.version,
  },
};
---

<Base title={`${t.key}: ${t.labelEn}`} description={t.definition} jsonLd={jsonLd}>
  <PageHead
    title={t.key}
    crumbs={[
      { href: '/vocabulary/', label: 'Vocabulary' },
      { href: `/vocabulary/#tier-${t.tier}`, label: tierLabel(t.tier) },
    ]}
  >
    <p class="lead">
      {t.labelEn}
      <span class="muted">·</span>
      <span lang="de">{t.labelDe}</span>{' '}
      {t.statutory && <span class="tag statutory">statutory</span>}
      {t.status !== 'draft' && <span class="tag provisional">{t.status}</span>}
    </p>
  </PageHead>

  <div class="prose">
    <p set:html={linkKeys(t.definition)} />
  </div>

  <dl class="facts">
    <dt>Key</dt>
    <dd><code>{t.key}</code></dd>

    <dt>Row name (BT-160)</dt>
    <dd>
      <code>{rowName(t)}</code><br />
      <code>{rowName(t, t.labelEn)}</code>
      {
        t.statutory ? (
          <p class="small muted dd-note">
            The labelled form is mandatory: VAT law requires the feature to be readable in the
            invoice.
          </p>
        ) : (
          <p class="small muted dd-note">
            The bare key <code>{t.key}</code> is also accepted.
          </p>
        )
      }
    </dd>

    <dt>Tier</dt>
    <dd><a href={`/vocabulary/#tier-${t.tier}`}>{tierLabel(t.tier)}</a></dd>

    <dt>Status</dt>
    <dd>{t.status}</dd>

    {
      scope && (
        <>
          <dt>Country scope</dt>
          <dd>
            <code>{scope}</code>: a national key, used only for facts that the law or an authority
            of that state defines. See the <a href="/naming-rules/#national">naming rules</a>.
          </dd>
        </>
      )
    }

    <dt>Representation term</dt>
    <dd>{t.representationTerm}</dd>

    <dt>Value format</dt>
    <dd set:html={linkKeys(t.valueFormat)} />

    <dt>Grammar</dt>
    <dd><code>{t.grammar}</code></dd>

    <dt>Unit</dt>
    <dd>
      {
        unit ? (
          <>
            {unit.name}
            {unit.code && (
              <span class="muted">
                {' '}
                (UN/ECE Rec. 20 code <code>{unit.code}</code>)
              </span>
            )}
            {unit.note && <span class="muted"> ({unit.note})</span>}
            <br />
            <span class="small muted dd-note">
              The unit is part of the key and never part of the value.
            </span>
          </>
        ) : (
          <span class="muted">none</span>
        )
      }
    </dd>

    <dt>Code list</dt>
    <dd>
      {
        lists.length > 0 ? (
          lists.map((l) => (
            <p class="flush">
              <a href={`/code-lists/#${l.anchor}`}>{l.title}</a>
            </p>
          ))
        ) : (
          <span set:html={linkKeys(t.codeList)} />
        )
      }
      {
        t.tokens.length > 0 && (
          <ul class="tokens dd-note">
            {t.tokens.map((tok) => (
              <li>
                <code>{tok}</code>
              </li>
            ))}
          </ul>
        )
      }
    </dd>

    <dt>Required when</dt>
    <dd set:html={linkKeys(t.conditionality)} />

    <dt>Statutory feature</dt>
    <dd>{t.statutory ? 'Yes' : 'No'}</dd>

    <dt>Repeatable</dt>
    <dd>{t.repeatable ? 'Yes, one row per value' : 'No, at most one row per line'}</dd>

    <dt>Anchors</dt>
    <dd>
      {
        anchors.length > 1 ? (
          <ul>
            {anchors.map((a) => (
              <li set:html={linkKeys(a)} />
            ))}
          </ul>
        ) : (
          <span set:html={linkKeys(t.anchors)} />
        )
      }
    </dd>

    <dt>Carrier and binding</dt>
    <dd set:html={linkKeys(t.carrier)} />

    {
      examples.length > 0 && (
        <>
          <dt>Values in the test corpus</dt>
          <dd>
            <ul class="tokens">
              {examples.map((v) => (
                <li>
                  <code>{v}</code>
                </li>
              ))}
            </ul>
          </dd>
        </>
      )
    }

    {
      crosswalk.length > 0 && (
        <>
          <dt>Crosswalk (informative)</dt>
          <dd>
            {crosswalk.map((c) => (
              <p class="flush">{c}</p>
            ))}
            {crosswalkNote && <p class="small muted dd-note">{crosswalkNote}</p>}
          </dd>
        </>
      )
    }
  </dl>

  <nav class="pager" aria-label="Neighbouring keys">
    <span>
      {
        prev && (
          <a href={termUrl(prev)} rel="prev">
            ← <code>{prev.key}</code>
          </a>
        )
      }
    </span>
    <span>
      {
        next && (
          <a href={termUrl(next)} rel="next">
            <code>{next.key}</code> →
          </a>
        )
      }
    </span>
  </nav>
</Base>
