{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vinvoice.org/schemas/registry.schema.json",
  "title": "VINvoice registry",
  "description": "Schema of generated/registry.json, the machine-readable VINvoice registry (served at https://vinvoice.org/downloads/registry.json).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "date", "licence", "prefix", "counts", "refs", "keys"],
  "properties": {
    "version": {
      "description": "Release, e.g. vehicle/1.0-draft.",
      "type": "string",
      "pattern": "^[a-z]+/[0-9]+\\.[0-9]+(-[a-z0-9.]+)?$"
    },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "licence": { "const": "CC0-1.0" },
    "prefix": {
      "description": "Prefix of every key, including the dot.",
      "type": "string",
      "pattern": "^[a-z]+\\.$"
    },
    "counts": {
      "description": "Number of keys per tier.",
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "refs": {
      "description": "Keys that the specification and the tools refer to by role, e.g. marker or marginScheme.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "keys": {
      "type": "array",
      "items": { "$ref": "key.schema.json" }
    }
  }
}
